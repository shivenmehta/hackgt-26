# Optional until Supabase is connected. Copy this file to .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only: never prefix private API keys with NEXT_PUBLIC_.
USDA_API_KEY=your-usda-api-key

# Optional server-only Grok calorie enrichment (GROK_API_KEY also accepted).
XAI_API_KEY=
GROK_MODEL=grok-4.20-0309-non-reasoning

# Optional local location service configuration. npm run dev starts both services.
# PYTHON_COMMAND=C:/path/to/python.exe
# LOCATION_SERVICE_PORT=8765
# LOCATION_SERVICE_URL=http://127.0.0.1:8765
# For independently started services, set the SAME private random 32+ character token.
# LOCATION_SERVICE_TOKEN=replace-with-a-long-random-server-only-value
# LOCATION_EVENTS_DB=.local/community-events.sqlite3
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Private weekly planner storage (server-only; never NEXT_PUBLIC_).
SUPABASE_SECRET_KEY=
# Generate independently with: openssl rand -hex 32
PLANNER_SESSION_SECRET=
RANKER_SERVICE_TOKEN=
# Local: http://127.0.0.1:8767; production: deployed Python project HTTPS URL.
RANKER_SERVICE_URL=http://127.0.0.1:8767
GROK_PLANNER_MODEL=grok-4.20-0309-non-reasoning
GROK_IMAGE_MODEL=grok-imagine-image-2.0
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
# Optional for protected ranker preview deployments.
RANKER_VERCEL_BYPASS_SECRET=

# Hosted Community only; omit to keep local SQLite development storage.
# LOCATION_EVENTS_BACKEND=supabase
# LOCATION_CACHE_PATH=/tmp/bridge-osm.sqlite3
# LOCATION_SNAP_DB=snap-retailers.sqlite3
